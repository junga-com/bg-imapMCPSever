# Copy to .env (which is gitignored). Never commit credentials.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=user@example.com
IMAP_PASSWORD=replace_me
IMAP_DEFAULT_FOLDER=INBOX
IMAP_TIMEOUT=20
IMAP_MAX_RESULTS=50
IMAP_MAX_BODY_CHARS=20000
IMAP_MAX_MESSAGE_BYTES=3000000

# Optional: built-in OAuth for remote MCP clients such as ChatGPT (see README "Remote access").
# Leave OAUTH_ISSUER_URL unset for the unauthenticated loopback-only mode.
# OAUTH_ISSUER_URL=https://<machine>.<tailnet>.ts.net   # port 443: ChatGPT rejects other ports
# OAUTH_OWNER_PASSWORD_HASH=   # written by: bg-imap-mcp-auth set-password
# OAUTH_ALLOWED_REDIRECT_ORIGINS=https://chatgpt.com
# OAUTH_STATE_DB=~/.local/state/bg-imap-mcp/oauth.sqlite3
